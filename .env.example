# ============================================================================
# Detent Service & Stateless Pod Configuration
# ============================================================================
PORT=3000
HOST=0.0.0.0
# Optional unique identifier for the K8s Pod (defaults to HOSTNAME or random UUID)
POD_ID=detent-pod-1
# Ephemeral scratch root inside the stateless Pod (cleaned up after every turn)
EPHEMERAL_ROOT=/tmp/detent-sandboxes
# Distributed MySQL lease lock TTL in seconds
LEASE_TTL_SECONDS=300
# How long a canUseTool callback holds an in-memory promise before suspending cleanly to MySQL
HOT_HOLD_TIMEOUT_MS=180000
# Recovery scan interval before jitter. Use 0 to disable, or at least 15000 ms.
WATCHDOG_INTERVAL_MS=30000
# Interrupted-turn recoveries before FAILED (0–5), reset after a successful turn.
WATCHDOG_MAX_RECOVERIES=1
# Failed-pipeline auto-fix budget per MR (0–10). A matching Hub rule can override it.
MR_MAX_AUTO_FIX_ATTEMPTS=3

# ============================================================================
# GitLab CE v18.3.0 Configuration
# ============================================================================
GITLAB_BASE_URL=http://gitlab.example.com
# Public callback URL reachable by GitLab webhooks (also enables in-GitLab onboarding tools)
# DETENT_PUBLIC_URL=https://detent.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=your-webhook-secret-token
# The Workspace Hub Repository Project ID whose Issues map 1:1 to Claude Code Sessions
GITLAB_HUB_PROJECT_ID=100
# Default branch of the Workspace Hub Repository (holds CLAUDE.md, agents, and shared skills)
GITLAB_HUB_DEFAULT_BRANCH=main
# Minimum GitLab access level required to approve Plans or Hook Tool executions (30 = Developer, 40 = Maintainer)
GITLAB_MIN_ACCESS_LEVEL=30
# Throttle interval (ms) for updating streaming progress in a single GitLab Issue or MR note
NOTE_STREAM_THROTTLE_MS=2000

# ============================================================================
# MySQL 8.0 Persistence Configuration (Sole Persistent State Store)
# ============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=detent
MYSQL_PASSWORD=detent_secret
MYSQL_DATABASE=detent
MYSQL_CONNECTION_LIMIT=10

# ============================================================================
# Claude Code / Anthropic Configuration
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional custom base URL / gateway
# ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TURNS=40
# Comma-separated readonly/safe Bash command prefixes allowed without Hook approval (leave empty to disable static Bash approvals)
SAFE_BASH_PREFIXES="git status,git diff,git log,git branch"

# Optional Jev / System One routing and command risk assessment
JEV_PROVIDER=off
JEV_THRESHOLD=0.9
# Minimum confidence for automatic Hub Agent routing
JEV_ROUTING_THRESHOLD=0.8
JEV_TIMEOUT_MS=2500
# Bailian Decision Model API (model defaults to decision-model-preview)
# JEV_PROVIDER=bailian
# JEV_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone
# JEV_API_KEY=
# TypeSafe (requires JEV_API_KEY, defaults to https://api.typesafe.ai/v1/systemone)
# JEV_PROVIDER=typesafe
# JEV_MODEL=jev-latest
# Custom System One service (API key optional)
# JEV_PROVIDER=custom
# JEV_BASE_URL=http://127.0.0.1:8000/v1/systemone

# Optional JSON file declaring external MCP capability packs and tool policies
# DETENT_MCP_CAPABILITIES_FILE=

# Delivery service (npm run start:delivery after npm run build)
DELIVERY_ENABLE_RELEASE_TOOLS=true
# Recommended: set jumpserver.base_url in Hub capabilities.json. Its single auth object
# references $secret:JMS_AK_ID and $secret:JMS_AK_SECRET for inspection and Ansible.
# DETENT_SECRET_JMS_AK_ID=
# DETENT_SECRET_JMS_AK_SECRET=
# With workflow account omitted and default_account empty, each asset uses its first
# active, non-@ authorized account. Inspections group by account. Playbooks need one common account.
# Optional legacy environment configuration for Hubs without a JumpServer entry.
# JUMPSERVER_BASE_URL=https://jumpserver.example.com
# JUMPSERVER_ORG_ID=your-organization-id
JUMPSERVER_TIMEOUT_MS=30000
# JUMPSERVER_READONLY_ACCOUNT=
# Legacy role credentials (Bearer token or AccessKey per role).
# JUMPSERVER_READONLY_TOKEN=
# JUMPSERVER_READONLY_ACCESS_KEY_ID=
# JUMPSERVER_READONLY_ACCESS_KEY_SECRET=
# JUMPSERVER_JOB_TOKEN=
# JUMPSERVER_JOB_ACCESS_KEY_ID=
# JUMPSERVER_JOB_ACCESS_KEY_SECRET=
JUMPSERVER_INSPECT_ALLOW_PREFIXES="systemctl status,nginx -t,df -h,free -m,uptime,ss -tlnp,kubectl get,cat /etc/nginx"
JUMPSERVER_BLOCKED_ASSETS=
JUMPSERVER_BLOCK_FAILED_PIPELINE=true
# Comma-separated GitLab usernames. Listed users must also meet GITLAB_MIN_ACCESS_LEVEL.
DELIVERY_PROD_APPROVERS=
# Used when DELIVERY_PROD_APPROVERS is empty (40 = Maintainer).
DELIVERY_PROD_MIN_ACCESS_LEVEL=40

# Hub capabilities.json can reference any DETENT_SECRET_<UPPERCASE_NAME>.
# Supply values in the Delivery service environment or its private env file.
# DETENT_SECRET_CUSTOM_MCP_TOKEN=
