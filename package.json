{
  "name": "detent",
  "version": "1.0.0",
  "description": "Detent: Stateless GitLab CE v18.3.0 Issue-to-Claude-Code Runtime & Governed AI Change Delivery Control Plane",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "test": "vitest run",
    "check": "npm run typecheck && npm run deadcode && npm test",
    "review": "ocr review --audience agent --background-file AGENT.md",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node packages/core/dist/server.js",
    "start:delivery": "node packages/delivery/dist/server.js",
    "dev:delivery": "tsx watch packages/delivery/src/server.ts",
    "dev": "tsx watch packages/core/src/server.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "e2e:gitlab": "npm run build && tsx scripts/e2e/run-offline-e2e.ts",
    "e2e:smoke": "npm run build && tsx scripts/e2e/run-offline-e2e.ts --suite=smoke",
    "e2e:offline": "npm run build && tsx scripts/e2e/run-offline-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "fflate": "^0.8.3",
    "knip": "^5.43.0",
    "mysql2": "^3.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
